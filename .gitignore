Set-Content -Path .gitignore -Value @"
# Dependencies
node_modules/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Next.js Build & Cache
.next/
out/
build/
dist/
*.tsbuildinfo

# Environment Secrets (CRITICAL)
.env
.env*.local
.env.production
.env.staging

# System & IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase & Testing
supabase/.temp/
supabase/.branches/
coverage/
.nyc_output/
"@